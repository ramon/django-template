{
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "bun run lint:biome && bun run lint:classes",
    "lint:biome": "biome check .",
    "lint:classes": "rustywind --check-formatted -l django templates apps",
    "lint:fix": "biome check --write . && bun run lint:classes:fix",
    "lint:classes:fix": "rustywind --write -l django templates apps",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "alpinejs": "^3.17.2",
    "htmx.org": "^2.0.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.14.5",
    "rustywind": "^0.28.0",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "rustywind"
  ]
}
