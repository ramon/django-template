[run]
branch = True
omit =
    manage.py
    __init__.py
    config/**/*
    ./apps/*/migrations/*
    ./apps/*/urls.py
    tests.py
    test_*.py
    *_tests.py
    # handle() chama gettext/msgmerge de verdade e mexe nos .po versionados; ja e'
    # coberto pelo step dedicado do CI (`makemessages` + `git diff --exit-code`),
    # nao pelo pytest.
    apps/core/management/commands/makemessages.py
    apps/core/management/commands/compilemessages.py

[report]

exclude_also =
    ; Don't complain about missing debug-only code:
    def __repr__
    if self\.debug
    def __repr__

    ; Don't complain if tests don't hit defensive assertion code:
    raise AssertionError
    raise NotImplementedError

    ; Don't complain about abstract methods, they aren't run:
    @(abc\.)?abstractmethod
