# ==============================================================================
# Copie para .env e ajuste. Os valores abaixo assumem o docker-compose do repo
# (Postgres e Valkey na maquina local).
#
#   cp .env.example .env
#
# Duas fontes de configuracao convivem aqui:
#   - django-environ  -> settings do framework, lidos em config/settings/parts/
#   - pydantic-settings -> configuracao da aplicacao, com prefixo APP_,
#     FEATURE_ ou INTEGRATION_ (config/app_settings/)
# ==============================================================================

# --- Django -------------------------------------------------------------------

# Unica variavel sem default: o boot falha se ela nao existir.
# Gere uma com:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-esta-chave-antes-de-subir-qualquer-coisa

# Nunca True fora da sua maquina.
DEBUG=True

# Lista separada por virgula. "*" so serve em desenvolvimento.
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Banco de dados -----------------------------------------------------------

# Casa com o servico `database` do docker-compose.yml.
# Sem esta variavel o projeto cai num SQLite em db.sqlite3.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/app

# --- Cache e sessao -----------------------------------------------------------

# Bancos distintos do Valkey/Redis por finalidade, para poder limpar um sem o outro.
CACHE_URL=redis://127.0.0.1:6379/0
CACHE_PREFIX=cache
SESSION_CACHE_URL=redis://127.0.0.1:6379/1
SESSION_CACHE_PREFIX=session

# --- Celery -------------------------------------------------------------------

# O backend de resultados e' o banco (django-db), configurado no codigo.
CELERY_BROKER_URL=redis://127.0.0.1:6379/2

# --- Internacionalizacao ------------------------------------------------------

LANGUAGE_CODE=pt-BR
TIME_ZONE=America/Sao_Paulo

# --- Autenticacao -------------------------------------------------------------

MIN_PASSWORD_LENGTH=8

# --- CORS ---------------------------------------------------------------------

# Ignorado enquanto DEBUG=True (ai todas as origens sao aceitas).
# Precisa de esquema e porta: https://app.exemplo.com,https://admin.exemplo.com
CORS_ALLOWED_ORIGINS=

# --- E-mail -------------------------------------------------------------------

# Em desenvolvimento o backend e' o console (config/settings/development.py):
# nada e' enviado e o SMTP abaixo nao chega a ser usado.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Arquivos estaticos e midia -----------------------------------------------

STATIC_URL=/static/
MEDIA_URL=/media/

# --- Observabilidade ----------------------------------------------------------

# Instala django_prometheus e expoe /monitoring/metrics.
# O servico `prometheus` do compose ja raspa esse endpoint.
ENABLE_PROMETHEUS=False

# ==============================================================================
# pydantic-settings
# ==============================================================================

# --- Aplicacao (APP_) ---------------------------------------------------------

# local | test | staging | production
APP_ENVIRONMENT=local

# Regiao padrao para interpretar telefones sem codigo de pais (ISO 3166-1 alpha-2).
APP_PHONE_NUMBER_REGION=BR

# --- Integracoes (INTEGRATION_) -----------------------------------------------

# So e' lido quando DEBUG=False; vazio desliga o Sentry.
INTEGRATION_SENTRY_DSN=

# --- Feature flags (FEATURE_) -------------------------------------------------

# Declare os campos em config/app_settings/feature.py e liste as variaveis aqui.
